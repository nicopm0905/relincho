# Base de datos (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js v5
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# Google OAuth (la via de entrada principal)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
# Resend solo envia desde un dominio verificado. Sin EMAIL_FROM con dominio
# propio los envios se omiten y quedan anotados en el log: no se inventa un
# remitente que rebotaria.
RESEND_API_KEY=""
EMAIL_FROM="Relincho <hola@tudominio.es>"
# Ponlo a "true" para ofrecer el enlace magico por email. Si se deja vacio y
# Google esta configurado, en produccion solo se ofrece Google.
EMAIL_LOGIN_ENABLED=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Cloudflare R2 (fotos y documentos; el bucket de documentos debe ser privado)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="relincho-files"
R2_PUBLIC_URL="https://pub-XXXX.r2.dev"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Yeguada de demostracion publica (solo lectura), la del QR del flyer
DEMO_TENANT_SLUG="yeguada-demo-andalucia"

# Gestor documental: cuota por yeguada
DOCUMENTS_QUOTA_MB="512"

# Asistente de la ficha del caballo (cuota diaria por yeguada)
GOOGLE_GENERATIVE_AI_API_KEY=""
CHAT_DAILY_LIMIT="200"

# Avisos de fallo: webhook de Slack, Discord o similar (opcional)
ERROR_WEBHOOK_URL=""

# Cron (Vercel Cron). Vercel programa en UTC.
CRON_SECRET=""  # openssl rand -hex 32

# Veri*Factu AEAT
AEAT_VERIFACTU_ENV="test"  # test | prod
AEAT_VERIFACTU_CERT_PATH=""
AEAT_VERIFACTU_CERT_PASSWORD=""

# Webhook de ajuste diario de entrenamiento (integraciones externas)
TRAINING_WEBHOOK_SECRET=""
