generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  GROOM
  VET_EXTERNAL
  OWNER_EXTERNAL
}

enum Sex {
  MALE
  FEMALE
  GELDING
}

enum HorseStatus {
  ACTIVE
  SOLD
  DEAD
  RETIRED
  IN_TRAINING
}

enum HealthEventType {
  VACCINE
  DEWORMING
  DENTAL
  FARRIER
  VET_CHECKUP
  TREATMENT
  INJURY
  OTHER
}

enum CoveringMethod {
  NATURAL
  AI_FRESH
  AI_REFRIGERATED
  AI_FROZEN
  ET
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum VerifactuMode {
  VERIFACTU
  NO_VERIFACTU
}

model Tenant {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  fiscalName        String?
  nif               String?
  address           String?
  city              String?
  province          String?
  postalCode        String?
  country           String             @default("ES")
  regaCode          String?
  plan              String             @default("starter")
  stripeCustomerId  String?
  stripePriceId     String?
  /// Estado de la suscripcion en Stripe (active, past_due, canceled...). Sirve
  /// para avisar de un pago pendiente sin depender de una llamada a la API.
  stripeStatus      String?
  stripeCurrentPeriodEnd DateTime?
  verifactuMode     VerifactuMode      @default(NO_VERIFACTU)
  /// De donde vino esta yeguada (flyer, feria, boca a boca). Se rellena en el
  /// alta a partir del primer toque con `?src=`.
  acquisitionSource   String?
  acquisitionReferrer String?
  createdAt         DateTime           @default(now())
  memberships       Membership[]
  horses            Horse[]
  contacts          Contact[]
  products          Product[]
  invoices          Invoice[]
  invoiceSeries     InvoiceSeries[]
  boardingContracts BoardingContract[]
  events            Event[]
  tasks             Task[]
  documents         Document[]
  verifactuRecords VerifactuRecord[]
  reproSettings    ReproSettings?
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
  uploadedDocuments Document[] @relation("DocumentUploadedBy")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id          String        @id @default(uuid())
  userId      String
  tenantId    String
  role        Role
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horseAccess HorseAccess[]

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Horse {
  id               String              @id @default(uuid())
  tenantId         String
  name             String
  uelnCode         String?
  microchip        String?
  sex              Sex
  coat             String?
  breed            String?
  birthDate        DateTime?
  hierro           String?
  status           HorseStatus         @default(ACTIVE)
  boxLocation      String?
  photoUrl         String?
  sireId           String?
  damId            String?
  currentOwnerId   String?
  /// Numero de inscripcion en el Libro Genealogico PRE (ANCCE). No es el UELN.
  lgNumber         String?
  /// Criador (quien figura como tal en el LG), distinto del propietario actual.
  breederId        String?
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sire             Horse?              @relation("Sire", fields: [sireId], references: [id])
  dam              Horse?              @relation("Dam", fields: [damId], references: [id])
  sireOf           Horse[]             @relation("Sire")
  damOf            Horse[]             @relation("Dam")
  owner            Contact?            @relation("HorseOwner", fields: [currentOwnerId], references: [id])
  breeder          Contact?            @relation("HorseBreeder", fields: [breederId], references: [id], onDelete: SetNull)
  healthEvents     HealthEvent[]
  trainings        TrainingSession[]
  documents        Document[]
  movements        Movement[]
  feedingPlan      FeedingPlan?
  reproCycles      ReproductionCycle[]
  coverings        Covering[]          @relation("CoveringMare")
  sirings          Covering[]          @relation("CoveringStallion")
  horseAccess      HorseAccess[]
  boardingContract BoardingContract?
  invoiceLines     InvoiceLine[]
  feedingLogs      FeedingLog[]
  dailyJournals    DailyJournal[]
  competitionTargets CompetitionTarget[]
  chipTags         ChipTag[]
  vetProfile       VeterinaryProfile?
  macrocycles      Macrocycle[]
  dailyLoads       DailyLoad[]
  events           Event[]
  nutritionBaseline NutritionBaseline?
  nutritionPrescriptions NutritionPrescription[]
  reproExams       ReproExam[]
  reproProfile     MareReproProfile?
  semenBatches     SemenBatch[]        @relation("SemenStallion")
  createdAt        DateTime            @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
}

model HorseAccess {
  id           String     @id @default(uuid())
  horseId      String
  membershipId String
  horse        Horse      @relation(fields: [horseId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([horseId, membershipId])
}

model Contact {
  id                String             @id @default(uuid())
  tenantId          String
  kind              String
  name              String
  nif               String?
  email             String?
  phone             String?
  address           String?
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horses            Horse[]            @relation("HorseOwner")
  bredHorses        Horse[]            @relation("HorseBreeder")
  boardingContracts BoardingContract[]
  invoices          Invoice[]

  @@index([tenantId])
}

model HealthEvent {
  id            String          @id @default(uuid())
  tenantId      String
  horseId       String
  type          HealthEventType
  name          String
  date          DateTime
  nextDueDate   DateTime?
  dose          String?
  vetContactId  String?
  cost          Decimal?        @db.Decimal(10, 2)
  notes         String?
  attachmentUrl String?
  horse         Horse           @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@index([tenantId, horseId])
  @@index([tenantId, nextDueDate])
}

model TrainingSession {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String
  date      DateTime
  riderName String?
  minutes   Int
  type      String?
  notes     String?
  rpe       Int?
  internalLoadUa Int?
  fatigueZone    FatigueZone?
  sweatLoss      SweatLoss?
  /// Dato medido, opcional: el caballo no dice la intensidad, por eso la
  /// fuente principal es el jinete y esto solo la matiza.
  heartRateBpm   Int?
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  dailyLoad DailyLoad?

  @@index([tenantId, horseId])
  @@index([tenantId, date])
}

model FeedingPlan {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String   @unique
  items     Json
  startDate DateTime @default(now())
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
}

model FeedingLog {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String
  date      DateTime @default(now())
  mealType  String   // MAÑANA, MEDIODIA, TARDE
  status    String   // DONE, SKIPPED
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  
  @@unique([horseId, date, mealType]) // Para no duplicar logs del mismo día y comida
  @@index([tenantId, date])
}

model Product {
  id       String   @id @default(uuid())
  tenantId String
  sku      String?
  name     String
  kind     String
  unit     String   @default("kg")
  stock    Decimal? @db.Decimal(10, 2)
  cost     Decimal? @db.Decimal(10, 2)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Documento de una yeguada: pasaporte, radiografia, analitica, contrato...
///
/// El fichero vive en un bucket privado y se sirve con una URL firmada que
/// caduca: son datos personales y clinicos, asi que no pueden colgar de una
/// URL publica permanente que se pueda reenviar y quede viva para siempre.
model Document {
  id           String    @id @default(uuid())
  tenantId     String
  horseId      String?
  kind         String
  name         String
  /// Solo se rellena con el almacenamiento local de desarrollo.
  fileUrl      String?
  /// Clave dentro del bucket: <tenantId>/documents/<uuid>.<ext>.
  storageKey   String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  /// Caducidad del propio documento (vacunacion, coggins, seguro).
  expiresAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horse        Horse?    @relation(fields: [horseId], references: [id], onDelete: SetNull)
  uploadedBy   User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, horseId])
  @@index([tenantId, deletedAt])
}

model Movement {
  id              String   @id @default(uuid())
  tenantId        String
  horseId         String
  direction       String
  date            DateTime
  originRega      String?
  destinationRega String?
  reason          String?
  horse           Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([tenantId, horseId])
}

/// Temporada reproductiva de una yegua (una por año). Dentro caben varios
/// ciclos estrales: se deducen de las exploraciones (`ReproExam`), no se
/// guardan aparte.
model ReproductionCycle {
  id        String      @id @default(uuid())
  tenantId  String
  mareId    String
  season    Int
  /// Categoria de la yegua al empezar la temporada (MAIDEN, BARREN, FOALING,
  /// SLIPPED, RESTED). Null = se deduce del historial.
  category  String?
  notes     String?
  mare      Horse       @relation(fields: [mareId], references: [id], onDelete: Cascade)
  coverings Covering[]
  exams     ReproExam[]

  @@index([tenantId, mareId])
}

model Covering {
  id                    String            @id @default(uuid())
  tenantId              String
  cycleId               String
  mareId                String
  stallionId            String?
  /// Semental de fuera de la yeguada (centro de sementales, IA con semen comprado).
  externalStallionName  String?
  semenBatchId          String?
  /// Dosis (pajuelas) gastadas de `semenBatch` en esta cubricion.
  dosesUsed             Int?
  method                CoveringMethod
  /// Fecha y hora: la ventana de inseminacion se cuenta en horas.
  date                  DateTime
  result                String?
  notes                 String?
  ancceServiceRequestId String?
  cycle                 ReproductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  mare                  Horse             @relation("CoveringMare", fields: [mareId], references: [id])
  stallion              Horse?            @relation("CoveringStallion", fields: [stallionId], references: [id])
  semenBatch            SemenBatch?       @relation(fields: [semenBatchId], references: [id], onDelete: SetNull)
  pregnancyChecks       PregnancyCheck[]
  foaling               Foaling?
  foalingWatch          FoalingWatch[]

  @@index([tenantId])
}

model PregnancyCheck {
  id             String   @id @default(uuid())
  tenantId       String
  coveringId     String
  date           DateTime
  result         String
  dayOfPregnancy Int?
  /// Diametro de la vesicula embrionaria (mm).
  vesicleMm      Int?
  heartbeat      Boolean?
  notes          String?
  covering       Covering @relation(fields: [coveringId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Foaling {
  id         String   @id @default(uuid())
  tenantId   String
  coveringId String   @unique
  foalId     String?
  date       DateTime
  sex        Sex?
  alive      Boolean  @default(true)
  notes      String?
  /// Regla 1-2-3: minutos desde el nacimiento hasta que el potro se levanta,
  /// mama y la yegua expulsa la placenta.
  foalStoodMinutes   Int?
  foalSuckledMinutes Int?
  placentaMinutes    Int?
  meconiumPassed     Boolean?
  /// IgG del potro a las 12-24 h (mg/dl): transferencia de inmunidad pasiva.
  foalIggMgDl        Int?
  birthWeightKg      Decimal? @db.Decimal(5, 1)
  /// DYSTOCIA, RED_BAG, RETAINED_PLACENTA, WEAK_FOAL, OTHER.
  complications      String[] @default([])
  covering   Covering @relation(fields: [coveringId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Vigilancia preparto de una gestacion: desarrollo de la ubre, cera y calcio
/// en leche (>= 200 ppm anuncia el parto en 24-72 h).
model FoalingWatch {
  id             String   @id @default(uuid())
  tenantId       String
  coveringId     String
  date           DateTime
  /// Ubre: 0 sin cambios, 1 empieza, 2 llena, 3 a tope.
  udderScore     Int?
  wax            Boolean  @default(false)
  milkCalciumPpm Int?
  /// Relajacion de ligamentos de la grupa y vulva.
  relaxation     Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  covering       Covering @relation(fields: [coveringId], references: [id], onDelete: Cascade)

  @@index([tenantId, coveringId])
}

/// Lote de semen (fresco, refrigerado o pajuelas congeladas). Las dosis
/// restantes son `dosesTotal` menos las gastadas en cubriciones.
model SemenBatch {
  id                   String     @id @default(uuid())
  tenantId             String
  stallionId           String?
  externalStallionName String?
  /// FRESH | REFRIGERATED | FROZEN
  semenType            String
  provider             String?
  dosesTotal           Int
  collectedAt          DateTime?
  /// Tanque/canastilla donde esta guardado.
  location             String?
  costPerDose          Decimal?   @db.Decimal(10, 2)
  notes                String?
  createdAt            DateTime   @default(now())
  stallion             Horse?     @relation("SemenStallion", fields: [stallionId], references: [id], onDelete: SetNull)
  coverings            Covering[]

  @@index([tenantId])
}

/// Exploracion ginecologica: recela, ecografia de ovarios y utero, y los
/// tratamientos hormonales de ese momento. Es lo que alimenta la prediccion de
/// celo y ovulacion.
model ReproExam {
  id              String            @id @default(uuid())
  tenantId        String
  cycleId         String
  mareId          String
  /// Fecha y hora: la ovulacion se predice en horas.
  date            DateTime
  /// Recela: 0 rechaza el semental ... 4 celo franco.
  teasingScore    Int?
  /// Foliculo dominante de cada ovario (mm).
  leftFollicleMm  Int?
  rightFollicleMm Int?
  /// Cuerpo luteo: NONE | LEFT | RIGHT | BOTH.
  corpusLuteum    String?
  /// Edema uterino (0-3).
  uterineEdema    Int?
  /// Liquido intrauterino (mm de la mayor bolsa; 0 = sin liquido).
  uterineFluidMm  Int?
  /// Cervix: CLOSED | RELAXING | OPEN.
  cervix          String?
  /// Ovulacion detectada en esta exploracion.
  ovulated        Boolean           @default(false)
  ovulationSide   String?
  /// HCG, DESLORELIN, PGF2A, ALTRENOGEST, OXYTOCIN, UTERINE_LAVAGE, ANTIBIOTIC, OTHER.
  treatments      String[]          @default([])
  notes           String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  cycle           ReproductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  mare            Horse             @relation(fields: [mareId], references: [id], onDelete: Cascade)

  @@index([tenantId, mareId, date])
  @@index([cycleId])
}

/// Lo propio de cada yegua. Los valores numericos son correcciones manuales:
/// si estan vacios se aprenden del historial o se usan los de la yeguada.
model MareReproProfile {
  id                     String   @id @default(uuid())
  tenantId               String
  horseId                String   @unique
  cycleLengthDays        Int?
  estrusLengthDays       Int?
  gestationDays          Int?
  preovulatoryFollicleMm Int?
  /// Antecedentes: ENDOMETRITIS, FLUID_POST_BREEDING, RETAINED_PLACENTA,
  /// TWINNING, DYSTOCIA, CERVICAL_ISSUE, OTHER.
  conditions             String[] @default([])
  notes                  String?
  horse                  Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
}

/// Parametros reproductivos de la yeguada. `config` se valida con
/// `reproSettingsSchema` (src/lib/repro-settings.ts), que rellena los valores
/// por defecto: añadir un parametro no necesita migracion.
model ReproSettings {
  tenantId  String   @id
  config    Json     @default("{}")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model BoardingContract {
  id         String    @id @default(uuid())
  tenantId   String
  clientId   String
  horseId    String    @unique
  startDate  DateTime
  endDate    DateTime?
  monthlyFee Decimal   @db.Decimal(10, 2)
  vatRate    Decimal   @default(21) @db.Decimal(5, 2)
  includes   String[]
  active     Boolean   @default(true)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Contact   @relation(fields: [clientId], references: [id])
  horse      Horse     @relation(fields: [horseId], references: [id])
  invoices   Invoice[]
  extras     BoardingContractExtra[]

  @@index([tenantId])
}

model BoardingContractExtra {
  id                 String           @id @default(uuid())
  tenantId           String
  boardingContractId String
  concept            String
  amount             Decimal          @db.Decimal(10, 2)
  vatRate            Decimal          @default(21) @db.Decimal(5, 2)
  recurring          Boolean          @default(true)
  oneOffApplied      Boolean          @default(false)
  createdAt          DateTime         @default(now())
  boardingContract   BoardingContract @relation(fields: [boardingContractId], references: [id], onDelete: Cascade)

  @@index([tenantId, boardingContractId])
}

model InvoiceSeries {
  id         String    @id @default(uuid())
  tenantId   String
  code       String
  prefix     String
  year       Int
  nextNumber Int       @default(1)
  isDefault  Boolean   @default(false)
  /// La ley exige serie propia para las rectificativas.
  isRectifying Boolean  @default(false)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices   Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Invoice {
  id                 String        @id @default(uuid())
  tenantId           String
  series             String
  seriesId           String?
  /// Se asigna al emitir: un borrador no consume numero (ni fecha).
  number             Int?
  issueDate          DateTime
  dueDate            DateTime?
  clientId           String
  boardingContractId String?
  subtotal           Decimal       @db.Decimal(12, 2)
  vatTotal           Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  status             InvoiceStatus @default(DRAFT)
  verifactuMode      VerifactuMode @default(NO_VERIFACTU)
  verifactuHash      String?
  verifactuPrevHash  String?
  verifactuQrUrl     String?
  verifactuSentAt    DateTime?
  pdfUrl             String?
  /// F1 completa, F2 simplificada, R1-R4 rectificativa (claves de la AEAT).
  invoiceType        String        @default("F1")
  /// Factura que esta rectifica, si es rectificativa.
  rectifiesId        String?
  /// "S" sustitucion o "I" por diferencias.
  rectificationKind  String?
  rectificationReason String?
  /// Mes de pupilaje facturado ("2026-09"): evita facturar dos veces el mismo mes.
  periodMonth        String?
  client             Contact       @relation(fields: [clientId], references: [id])
  rectifies          Invoice?      @relation("Rectification", fields: [rectifiesId], references: [id], onDelete: Restrict)
  rectifiedBy        Invoice[]     @relation("Rectification")
  verifactuRecords   VerifactuRecord[]
  boardingContract   BoardingContract? @relation(fields: [boardingContractId], references: [id])
  invoiceSeries      InvoiceSeries? @relation(fields: [seriesId], references: [id])
  lines              InvoiceLine[]
  payments           Payment[]
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, series, number])
  @@unique([boardingContractId, periodMonth])
  @@index([tenantId, issueDate])
}

/**
 * Registro de facturacion Veri*Factu: cada alta o anulacion encadena su huella
 * con la del registro anterior del mismo emisor. Inmutable una vez creado.
 */
model VerifactuRecord {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  /// "ALTA" o "ANULACION"
  kind        String
  hash        String
  prevHash    String?
  /// Texto exacto de FechaHoraHusoGenRegistro usado en la huella.
  generatedAt String
  /// XML del registro, listo para el envio.
  payload     String
  /// "PENDING" hasta que se envie a la AEAT.
  status      String   @default("PENDING")
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  horseId     String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  horse       Horse?   @relation(fields: [horseId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  method    String
  reference String?
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Task {
  id                   String    @id @default(uuid())
  tenantId             String
  horseId              String?
  assigneeMembershipId String?
  title                String
  dueDate              DateTime
  doneAt               DateTime?
  notes                String?
  /// Tareas generadas por el sistema (p. ej. hitos de gestacion): identifica
  /// su origen para no crearlas dos veces.
  sourceKey            String?
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceKey])
  @@index([tenantId, dueDate])
}

model Event {
  id       String    @id @default(uuid())
  tenantId String
  kind     String
  title    String
  startsAt DateTime
  endsAt   DateTime?
  location String?
  notes    String?
  /// Caballo al que se refiere (visita del veterinario, concurso...). Opcional.
  horseId  String?
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horse    Horse?    @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
}

model DailyJournal {
  id         String   @id @default(uuid())
  tenantId   String
  horseId    String
  date       DateTime @default(now())
  content    String   // Texto libre del usuario
  aiAnalysis String?  // Análisis generado por IA
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([tenantId, horseId, date])
}

model CompetitionTarget {
  id         String   @id @default(uuid())
  tenantId   String
  horseId    String
  name       String
  targetDate DateTime
  priority   String?  // Ej. "ALTA", "MEDIA", "BAJA"
  notes      String?
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  macrocycles Macrocycle[]

  @@index([tenantId, horseId, targetDate])
}

// ============================================================
// RENDIMIENTO / PREVENCION DE LESIONES + NUTRICION DINAMICA
// ============================================================

enum Discipline {
  DOMA_CLASICA
  DOMA_VAQUERA
  SALTO
  COMPLETO
  RAID
  ENGANCHES
  FUNCIONALIDAD
  OCIO
}

enum MesocyclePhase {
  ACUMULACION
  TRANSMUTACION
  REALIZACION
  TRANSICION
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum WorkType {
  DESCANSO
  RECUPERACION_ACTIVA
  PISTA_TECNICA
  PISTA_ALTA_INTENSIDAD
  CAMPO_FONDO
  GIMNASIA_SALTO
  COMPETICION
}

enum DayStatus {
  PLANNED
  COMPLETED
  MISSED
  ADJUSTED
}

enum FatigueZone {
  BAJA
  MEDIA
  ALTA
}

enum SweatLoss {
  BAJA
  MEDIA
  ALTA
}

enum ReproductiveStatus {
  NA
  CICLANDO
  GESTANTE
  LACTANDO
  SEMENTAL_EN_MONTA
  SEMENTAL_REPOSO
}

/// Emparejamiento chip fisico (NFC/RFID) <-> caballo.
model ChipTag {
  id         String   @id @default(uuid())
  tenantId   String
  horseId    String
  chipId     String   @unique
  kind       String   @default("NFC") // NFC | RFID
  active     Boolean  @default(true)
  pairedById String?
  pairedAt   DateTime @default(now())
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([tenantId, horseId])
}

/// Estado basal clinico y restricciones de carga fijadas por el veterinario.
model VeterinaryProfile {
  id                      String             @id @default(uuid())
  tenantId                String
  horseId                 String             @unique
  discipline              Discipline?
  baseWeightKg            Decimal?           @db.Decimal(6, 2)
  reproductiveStatus      ReproductiveStatus @default(NA)
  gestationMonth          Int?
  tendonHistoryAlert      Boolean            @default(false)
  maxImpactSurfaceMinutes Int?
  maxRpe                  Int?
  restrictions            String[]           @default([])
  notes                   String?
  horse                   Horse              @relation(fields: [horseId], references: [id], onDelete: Cascade)
  updatedAt               DateTime           @updatedAt

  @@index([tenantId])
}

/// Temporada completa hasta la fecha de competicion objetivo.
model Macrocycle {
  id                  String             @id @default(uuid())
  tenantId            String
  horseId             String
  name                String
  discipline          Discipline?
  startDate           DateTime
  targetDate          DateTime
  competitionTargetId String?
  status              PlanStatus         @default(ACTIVE)
  recoveryBufferPct   Int                @default(15)
  horse               Horse              @relation(fields: [horseId], references: [id], onDelete: Cascade)
  competitionTarget   CompetitionTarget? @relation(fields: [competitionTargetId], references: [id], onDelete: SetNull)
  mesocycles          Mesocycle[]
  createdAt           DateTime           @default(now())

  @@index([tenantId, horseId, status])
}

/// Bloque de 3-6 semanas con una orientacion concreta (volumen, intensidad, tapering).
model Mesocycle {
  id             String         @id @default(uuid())
  tenantId       String
  macrocycleId   String
  phase          MesocyclePhase
  orderIndex     Int
  startDate      DateTime
  endDate        DateTime
  weeks          Int
  volumeIndex    Float
  intensityIndex Float
  macrocycle     Macrocycle     @relation(fields: [macrocycleId], references: [id], onDelete: Cascade)
  microcycles    Microcycle[]

  @@unique([macrocycleId, orderIndex])
  @@index([tenantId])
}

/// Semana de 7 dias con su carga planificada.
model Microcycle {
  id                String      @id @default(uuid())
  tenantId          String
  mesocycleId       String
  weekNumber        Int
  startDate         DateTime
  endDate           DateTime
  plannedLoadUa     Int
  actualLoadUa      Int         @default(0)
  mandatoryRestDays Int         @default(2)
  bufferStatus      String      @default("idle") // idle | active | exhausted
  mesocycle         Mesocycle   @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  days              DailyLoad[]

  @@unique([mesocycleId, weekNumber])
  @@index([tenantId])
}

/// Carga diaria planificada y su ejecucion real.
model DailyLoad {
  id                   String           @id @default(uuid())
  tenantId             String
  microcycleId         String
  horseId              String
  date                 DateTime         @db.Date
  workType             WorkType
  rpeTarget            Int
  durationMinutes      Int
  plannedLoadUa        Int
  impactSurfaceMinutes Int              @default(0)
  status               DayStatus        @default(PLANNED)
  actualRpe            Int?
  actualMinutes        Int?
  actualLoadUa         Int?
  fatigueZone          FatigueZone?
  adjustmentReason     String?
  trainingSessionId    String?          @unique
  microcycle           Microcycle       @relation(fields: [microcycleId], references: [id], onDelete: Cascade)
  horse                Horse            @relation(fields: [horseId], references: [id], onDelete: Cascade)
  trainingSession      TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  @@unique([microcycleId, date])
  @@index([tenantId, horseId, date])
}

/// Dieta estatica y techos de seguridad definidos por el veterinario.
model NutritionBaseline {
  id                     String   @id @default(uuid())
  tenantId               String
  horseId                String   @unique
  baseForageKg           Decimal  @db.Decimal(5, 2)
  baseConcentrateKg      Decimal  @db.Decimal(5, 2)
  proteinPercentTarget   Int      @default(12)
  mealsPerDay            Int      @default(3)
  minForagePctBodyweight Decimal  @default(1.5) @db.Decimal(4, 2)
  maxConcentrateKgPerDay Decimal  @db.Decimal(5, 2)
  maxConcentrateKgPerMeal Decimal @default(2) @db.Decimal(4, 2)
  maxElectrolytesGrams   Int      @default(90)
  maxVitaminEIu          Int      @default(5000)
  supplements            Json?
  horse                  Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
}

/// Racion calculada para un dia concreto a partir de la carga y el estado clinico.
model NutritionPrescription {
  id                    String       @id @default(uuid())
  tenantId              String
  horseId               String
  date                  DateTime     @db.Date
  internalLoadUa        Int          @default(0)
  fatigueZone           FatigueZone  @default(BAJA)
  mesocyclePhase        MesocyclePhase?
  forageKg              Decimal      @db.Decimal(5, 2)
  concentrateKg         Decimal      @db.Decimal(5, 2)
  extraConcentrateGrams Int          @default(0)
  proteinPercentTarget  Int
  electrolytesGrams     Int          @default(0)
  vitaminEIu            Int          @default(0)
  seleniumMg            Decimal?     @db.Decimal(4, 2)
  bcaa                  Boolean      @default(false)
  totalMeals            Int
  instructionsForStaff  String
  clampNotes            String[]     @default([])
  ambientTempC          Float?
  /// true mientras la racion sale de la carga planificada. Pasa a false cuando
  /// el jinete reporta la sesion real de ese dia.
  isProjection          Boolean      @default(false)
  /// Tipo de trabajo previsto, para que el mozo entienda de donde sale la racion.
  workType              WorkType?
  horse                 Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  computedAt            DateTime     @default(now())

  @@unique([horseId, date])
  @@index([tenantId, date])
}
