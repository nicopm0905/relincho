generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  GROOM
  VET_EXTERNAL
  OWNER_EXTERNAL
}

enum Sex {
  MALE
  FEMALE
  GELDING
}

enum HorseStatus {
  ACTIVE
  SOLD
  DEAD
  RETIRED
  IN_TRAINING
}

enum HealthEventType {
  VACCINE
  DEWORMING
  DENTAL
  FARRIER
  VET_CHECKUP
  TREATMENT
  INJURY
  OTHER
}

enum CoveringMethod {
  NATURAL
  AI_FRESH
  AI_REFRIGERATED
  AI_FROZEN
  ET
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum VerifactuMode {
  VERIFACTU
  NO_VERIFACTU
}

model Tenant {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  fiscalName        String?
  nif               String?
  address           String?
  city              String?
  province          String?
  postalCode        String?
  country           String             @default("ES")
  regaCode          String?
  plan              String             @default("starter")
  stripeCustomerId  String?
  stripePriceId     String?
  verifactuMode     VerifactuMode      @default(NO_VERIFACTU)
  createdAt         DateTime           @default(now())
  memberships       Membership[]
  horses            Horse[]
  contacts          Contact[]
  products          Product[]
  invoices          Invoice[]
  boardingContracts BoardingContract[]
  events            Event[]
  tasks             Task[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id          String        @id @default(uuid())
  userId      String
  tenantId    String
  role        Role
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horseAccess HorseAccess[]

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Horse {
  id               String              @id @default(uuid())
  tenantId         String
  name             String
  uelnCode         String?
  microchip        String?
  sex              Sex
  coat             String?
  breed            String?
  birthDate        DateTime?
  hierro           String?
  status           HorseStatus         @default(ACTIVE)
  boxLocation      String?
  photoUrl         String?
  sireId           String?
  damId            String?
  currentOwnerId   String?
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sire             Horse?              @relation("Sire", fields: [sireId], references: [id])
  dam              Horse?              @relation("Dam", fields: [damId], references: [id])
  sireOf           Horse[]             @relation("Sire")
  damOf            Horse[]             @relation("Dam")
  owner            Contact?            @relation(fields: [currentOwnerId], references: [id])
  healthEvents     HealthEvent[]
  trainings        TrainingSession[]
  documents        Document[]
  movements        Movement[]
  feedingPlan      FeedingPlan?
  reproCycles      ReproductionCycle[]
  coverings        Covering[]          @relation("CoveringMare")
  sirings          Covering[]          @relation("CoveringStallion")
  horseAccess      HorseAccess[]
  boardingContract BoardingContract?
  invoiceLines     InvoiceLine[]
  feedingLogs      FeedingLog[]
  dailyJournals    DailyJournal[]
  competitionTargets CompetitionTarget[]
  chipTags         ChipTag[]
  vetProfile       VeterinaryProfile?
  macrocycles      Macrocycle[]
  dailyLoads       DailyLoad[]
  nutritionBaseline NutritionBaseline?
  nutritionPrescriptions NutritionPrescription[]
  createdAt        DateTime            @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
}

model HorseAccess {
  id           String     @id @default(uuid())
  horseId      String
  membershipId String
  horse        Horse      @relation(fields: [horseId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([horseId, membershipId])
}

model Contact {
  id                String             @id @default(uuid())
  tenantId          String
  kind              String
  name              String
  nif               String?
  email             String?
  phone             String?
  address           String?
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horses            Horse[]
  boardingContracts BoardingContract[]
  invoices          Invoice[]

  @@index([tenantId])
}

model HealthEvent {
  id            String          @id @default(uuid())
  tenantId      String
  horseId       String
  type          HealthEventType
  name          String
  date          DateTime
  nextDueDate   DateTime?
  dose          String?
  vetContactId  String?
  cost          Decimal?        @db.Decimal(10, 2)
  notes         String?
  attachmentUrl String?
  horse         Horse           @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@index([tenantId, horseId])
  @@index([tenantId, nextDueDate])
}

model TrainingSession {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String
  date      DateTime
  riderName String?
  minutes   Int
  type      String?
  notes     String?
  rpe       Int?
  internalLoadUa Int?
  fatigueZone    FatigueZone?
  sweatLoss      SweatLoss?
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  dailyLoad DailyLoad?

  @@index([tenantId, horseId])
  @@index([tenantId, date])
}

model FeedingPlan {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String   @unique
  items     Json
  startDate DateTime @default(now())
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
}

model FeedingLog {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String
  date      DateTime @default(now())
  mealType  String   // MAÑANA, MEDIODIA, TARDE
  status    String   // DONE, SKIPPED
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  
  @@unique([horseId, date, mealType]) // Para no duplicar logs del mismo día y comida
  @@index([tenantId, date])
}

model Product {
  id       String   @id @default(uuid())
  tenantId String
  sku      String?
  name     String
  kind     String
  unit     String   @default("kg")
  stock    Decimal? @db.Decimal(10, 2)
  cost     Decimal? @db.Decimal(10, 2)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Document {
  id        String   @id @default(uuid())
  tenantId  String
  horseId   String?
  kind      String
  name      String
  fileUrl   String
  createdAt DateTime @default(now())
  horse     Horse?   @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([tenantId, horseId])
}

model Movement {
  id              String   @id @default(uuid())
  tenantId        String
  horseId         String
  direction       String
  date            DateTime
  originRega      String?
  destinationRega String?
  reason          String?
  horse           Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([tenantId, horseId])
}

model ReproductionCycle {
  id        String     @id @default(uuid())
  tenantId  String
  mareId    String
  season    Int
  notes     String?
  mare      Horse      @relation(fields: [mareId], references: [id], onDelete: Cascade)
  coverings Covering[]

  @@index([tenantId, mareId])
}

model Covering {
  id                    String            @id @default(uuid())
  tenantId              String
  cycleId               String
  mareId                String
  stallionId            String?
  method                CoveringMethod
  date                  DateTime
  result                String?
  ancceServiceRequestId String?
  cycle                 ReproductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  mare                  Horse             @relation("CoveringMare", fields: [mareId], references: [id])
  stallion              Horse?            @relation("CoveringStallion", fields: [stallionId], references: [id])
  pregnancyChecks       PregnancyCheck[]
  foaling               Foaling?

  @@index([tenantId])
}

model PregnancyCheck {
  id             String   @id @default(uuid())
  coveringId     String
  date           DateTime
  result         String
  dayOfPregnancy Int?
  covering       Covering @relation(fields: [coveringId], references: [id], onDelete: Cascade)
}

model Foaling {
  id         String   @id @default(uuid())
  coveringId String   @unique
  foalId     String?
  date       DateTime
  sex        Sex?
  alive      Boolean  @default(true)
  notes      String?
  covering   Covering @relation(fields: [coveringId], references: [id], onDelete: Cascade)
}

model BoardingContract {
  id         String    @id @default(uuid())
  tenantId   String
  clientId   String
  horseId    String    @unique
  startDate  DateTime
  endDate    DateTime?
  monthlyFee Decimal   @db.Decimal(10, 2)
  vatRate    Decimal   @default(21) @db.Decimal(5, 2)
  includes   String[]
  active     Boolean   @default(true)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Contact   @relation(fields: [clientId], references: [id])
  horse      Horse     @relation(fields: [horseId], references: [id])
  invoices   Invoice[]

  @@index([tenantId])
}

model Invoice {
  id                 String        @id @default(uuid())
  tenantId           String
  series             String
  number             Int
  issueDate          DateTime
  clientId           String
  boardingContractId String?
  subtotal           Decimal       @db.Decimal(12, 2)
  vatTotal           Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  status             InvoiceStatus @default(DRAFT)
  verifactuMode      VerifactuMode @default(NO_VERIFACTU)
  verifactuHash      String?
  verifactuPrevHash  String?
  verifactuQrUrl     String?
  verifactuSentAt    DateTime?
  pdfUrl             String?
  client             Contact       @relation(fields: [clientId], references: [id])
  boardingContract   BoardingContract? @relation(fields: [boardingContractId], references: [id])
  lines              InvoiceLine[]
  payments           Payment[]
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, series, number])
  @@index([tenantId, issueDate])
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  horseId     String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  horse       Horse?   @relation(fields: [horseId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  method    String
  reference String?
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Task {
  id                   String    @id @default(uuid())
  tenantId             String
  horseId              String?
  assigneeMembershipId String?
  title                String
  dueDate              DateTime
  doneAt               DateTime?
  notes                String?
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate])
}

model Event {
  id       String    @id @default(uuid())
  tenantId String
  kind     String
  title    String
  startsAt DateTime
  endsAt   DateTime?
  location String?
  notes    String?
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
}

model DailyJournal {
  id         String   @id @default(uuid())
  tenantId   String
  horseId    String
  date       DateTime @default(now())
  content    String   // Texto libre del usuario
  aiAnalysis String?  // Análisis generado por IA
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([tenantId, horseId, date])
}

model CompetitionTarget {
  id         String   @id @default(uuid())
  tenantId   String
  horseId    String
  name       String
  targetDate DateTime
  priority   String?  // Ej. "ALTA", "MEDIA", "BAJA"
  notes      String?
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  macrocycles Macrocycle[]

  @@index([tenantId, horseId, targetDate])
}

// ============================================================
// RENDIMIENTO / PREVENCION DE LESIONES + NUTRICION DINAMICA
// ============================================================

enum Discipline {
  DOMA_CLASICA
  DOMA_VAQUERA
  SALTO
  COMPLETO
  RAID
  ENGANCHES
  FUNCIONALIDAD
  OCIO
}

enum MesocyclePhase {
  ACUMULACION
  TRANSMUTACION
  REALIZACION
  TRANSICION
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum WorkType {
  DESCANSO
  RECUPERACION_ACTIVA
  PISTA_TECNICA
  PISTA_ALTA_INTENSIDAD
  CAMPO_FONDO
  GIMNASIA_SALTO
  COMPETICION
}

enum DayStatus {
  PLANNED
  COMPLETED
  MISSED
  ADJUSTED
}

enum FatigueZone {
  BAJA
  MEDIA
  ALTA
}

enum SweatLoss {
  BAJA
  MEDIA
  ALTA
}

enum ReproductiveStatus {
  NA
  CICLANDO
  GESTANTE
  LACTANDO
  SEMENTAL_EN_MONTA
  SEMENTAL_REPOSO
}

/// Emparejamiento chip fisico (NFC/RFID) <-> caballo.
model ChipTag {
  id         String   @id @default(uuid())
  tenantId   String
  horseId    String
  chipId     String   @unique
  kind       String   @default("NFC") // NFC | RFID
  active     Boolean  @default(true)
  pairedById String?
  pairedAt   DateTime @default(now())
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([tenantId, horseId])
}

/// Estado basal clinico y restricciones de carga fijadas por el veterinario.
model VeterinaryProfile {
  id                      String             @id @default(uuid())
  tenantId                String
  horseId                 String             @unique
  discipline              Discipline?
  baseWeightKg            Decimal?           @db.Decimal(6, 2)
  reproductiveStatus      ReproductiveStatus @default(NA)
  gestationMonth          Int?
  tendonHistoryAlert      Boolean            @default(false)
  maxImpactSurfaceMinutes Int?
  maxRpe                  Int?
  restrictions            String[]           @default([])
  notes                   String?
  horse                   Horse              @relation(fields: [horseId], references: [id], onDelete: Cascade)
  updatedAt               DateTime           @updatedAt

  @@index([tenantId])
}

/// Temporada completa hasta la fecha de competicion objetivo.
model Macrocycle {
  id                  String             @id @default(uuid())
  tenantId            String
  horseId             String
  name                String
  discipline          Discipline?
  startDate           DateTime
  targetDate          DateTime
  competitionTargetId String?
  status              PlanStatus         @default(ACTIVE)
  recoveryBufferPct   Int                @default(15)
  horse               Horse              @relation(fields: [horseId], references: [id], onDelete: Cascade)
  competitionTarget   CompetitionTarget? @relation(fields: [competitionTargetId], references: [id], onDelete: SetNull)
  mesocycles          Mesocycle[]
  createdAt           DateTime           @default(now())

  @@index([tenantId, horseId, status])
}

/// Bloque de 3-6 semanas con una orientacion concreta (volumen, intensidad, tapering).
model Mesocycle {
  id             String         @id @default(uuid())
  tenantId       String
  macrocycleId   String
  phase          MesocyclePhase
  orderIndex     Int
  startDate      DateTime
  endDate        DateTime
  weeks          Int
  volumeIndex    Float
  intensityIndex Float
  macrocycle     Macrocycle     @relation(fields: [macrocycleId], references: [id], onDelete: Cascade)
  microcycles    Microcycle[]

  @@unique([macrocycleId, orderIndex])
  @@index([tenantId])
}

/// Semana de 7 dias con su carga planificada.
model Microcycle {
  id                String      @id @default(uuid())
  tenantId          String
  mesocycleId       String
  weekNumber        Int
  startDate         DateTime
  endDate           DateTime
  plannedLoadUa     Int
  actualLoadUa      Int         @default(0)
  mandatoryRestDays Int         @default(2)
  bufferStatus      String      @default("idle") // idle | active | exhausted
  mesocycle         Mesocycle   @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  days              DailyLoad[]

  @@unique([mesocycleId, weekNumber])
  @@index([tenantId])
}

/// Carga diaria planificada y su ejecucion real.
model DailyLoad {
  id                   String           @id @default(uuid())
  tenantId             String
  microcycleId         String
  horseId              String
  date                 DateTime         @db.Date
  workType             WorkType
  rpeTarget            Int
  durationMinutes      Int
  plannedLoadUa        Int
  impactSurfaceMinutes Int              @default(0)
  status               DayStatus        @default(PLANNED)
  actualRpe            Int?
  actualMinutes        Int?
  actualLoadUa         Int?
  fatigueZone          FatigueZone?
  adjustmentReason     String?
  trainingSessionId    String?          @unique
  microcycle           Microcycle       @relation(fields: [microcycleId], references: [id], onDelete: Cascade)
  horse                Horse            @relation(fields: [horseId], references: [id], onDelete: Cascade)
  trainingSession      TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  @@unique([microcycleId, date])
  @@index([tenantId, horseId, date])
}

/// Dieta estatica y techos de seguridad definidos por el veterinario.
model NutritionBaseline {
  id                     String   @id @default(uuid())
  tenantId               String
  horseId                String   @unique
  baseForageKg           Decimal  @db.Decimal(5, 2)
  baseConcentrateKg      Decimal  @db.Decimal(5, 2)
  proteinPercentTarget   Int      @default(12)
  mealsPerDay            Int      @default(3)
  minForagePctBodyweight Decimal  @default(1.5) @db.Decimal(4, 2)
  maxConcentrateKgPerDay Decimal  @db.Decimal(5, 2)
  maxConcentrateKgPerMeal Decimal @default(2) @db.Decimal(4, 2)
  maxElectrolytesGrams   Int      @default(90)
  maxVitaminEIu          Int      @default(5000)
  supplements            Json?
  horse                  Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
}

/// Racion calculada para un dia concreto a partir de la carga y el estado clinico.
model NutritionPrescription {
  id                    String       @id @default(uuid())
  tenantId              String
  horseId               String
  date                  DateTime     @db.Date
  internalLoadUa        Int          @default(0)
  fatigueZone           FatigueZone  @default(BAJA)
  mesocyclePhase        MesocyclePhase?
  forageKg              Decimal      @db.Decimal(5, 2)
  concentrateKg         Decimal      @db.Decimal(5, 2)
  extraConcentrateGrams Int          @default(0)
  proteinPercentTarget  Int
  electrolytesGrams     Int          @default(0)
  vitaminEIu            Int          @default(0)
  seleniumMg            Decimal?     @db.Decimal(4, 2)
  bcaa                  Boolean      @default(false)
  totalMeals            Int
  instructionsForStaff  String
  clampNotes            String[]     @default([])
  ambientTempC          Float?
  /// true mientras la racion sale de la carga planificada. Pasa a false cuando
  /// el jinete reporta la sesion real de ese dia.
  isProjection          Boolean      @default(false)
  /// Tipo de trabajo previsto, para que el mozo entienda de donde sale la racion.
  workType              WorkType?
  horse                 Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  computedAt            DateTime     @default(now())

  @@unique([horseId, date])
  @@index([tenantId, date])
}
